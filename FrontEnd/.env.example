# Copie para .env e ajuste os valores.
#
# Vars EXPO_PUBLIC_* são embutidas no bundle do app (não são segredo, são
# só config de qual servidor/dispositivo usar).

# URL do BackEnd (ver BackEnd/README.md). No simulador iOS/web "localhost"
# funciona; no emulador Android use http://10.0.2.2:3000; num device físico
# (Expo Go) use o IP da sua máquina na rede local, ex: http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Precisa bater com o id_dispositivo semeado em BackEnd/db/init.sql — ainda
# não tem UI de troca de paciente no app (ver plan.md), então o dispositivo
# ativo é fixo por config. O nome do paciente já vem de verdade do
# GET /api/dispositivo/:id; a var abaixo só é usada como rótulo de fallback
# se essa chamada falhar antes do primeiro carregamento.
EXPO_PUBLIC_DEVICE_ID=ESP32-TESTE-01
EXPO_PUBLIC_PATIENT_NAME=Paciente
